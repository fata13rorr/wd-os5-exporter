# WD My Cloud OS5 connection
NAS_HOST=192.168.1.100
NAS_PORT=22
NAS_USER=sshd

# Path INSIDE the container
SSH_KEY=/run/secrets/nas_ssh_key

# Path to the private SSH key on the Docker host
SSH_KEY_FILE=./id_ed25519

# Cache WD metrics to avoid excessive SSH polling
CACHE_SECONDS=15

# Host port for the JSON API
EXPORTER_PORT=8085

TZ=Etc/UTC
